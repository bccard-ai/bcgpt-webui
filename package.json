		"js-sha256": "^0.11.1",
		"jspdf": "^4.2.1",
		"katex": "^0.17.0",
		"kokoro-js": "^1.2.1",
		"marked": "^18.0.4",
		"mermaid": "^11.15.0",
		"paneforge": "^1.0.2",
		"panzoom": "^9.4.4",
		"prosemirror-commands": "^1.7.1",
		"prosemirror-example-setup": "^1.2.3",
		"prosemirror-history": "^1.5.0",
		"prosemirror-keymap": "^1.2.3",
		"prosemirror-markdown": "^1.13.4",
		"prosemirror-model": "^1.25.7",
