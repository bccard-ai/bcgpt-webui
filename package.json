{
	"name": "bcgpt",
	"version": "1.0.0",
	"private": true,
	"license": "Apache-2.0",
	"author": "BC Card AI Team <seen@bccard.com>",
	"homepage": "https://github.com/bccard-ai/bcgpt-webui",
	"repository": {
		"type": "git",
		"url": "https://github.com/bccard-ai/bcgpt-webui.git"
	},
	"bugs": {
		"url": "https://github.com/bccard-ai/bcgpt-webui/issues"
	},
	"scripts": {
		"dev": "bun run pyodide:fetch && concurrently -n frontend,backend -c blue,green \"vite dev --host\" \"bun run dev:backend\"",
		"dev:backend": "bun scripts/watch-backend.js",
		"dev:frontend": "bun run pyodide:fetch && vite dev --host",
		"dev:5050": "bun run pyodide:fetch && vite dev --port 5050",
		"build": "bun run pyodide:fetch && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "bun run lint:frontend ; bun run lint:types ; bun run lint:backend",
		"lint:frontend": "eslint . --fix",
		"lint:frontend:check": "eslint .",
		"lint:types": "bun run check",
		"lint:backend": "pylint backend/",
		"check:ratchet": "python scripts/check_ratchet.py",
		"check:fetch": "python scripts/check_direct_fetch.py",
		"check:routes": "python scripts/extract_route_authorization.py",
		"format": "prettier --plugin-search-dir --write \"**/*.{js,ts,svelte,css,md,html,json}\"",
		"format:check": "prettier --plugin-search-dir --check \"**/*.{js,ts,svelte,css,md,html,json}\"",
		"format:backend": "black . --exclude \".venv/|/venv/\"",
		"format:backend:check": "black --check backend/bcgpt/",
		"i18n:parse": "i18next-cli extract && prettier --write \"src/lib/i18n/**/*.{js,json}\"",
		"cy:open": "cypress open",
		"test:frontend": "vitest run",
		"pyodide:fetch": "bun scripts/prepare-pyodide.js",
		"github": "bun scripts/sync-github-repo.js",
		"analyze": "ANALYZE=true vite build",
		"prepare": "husky"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "3.2.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/postcss": "^4.3.0",
		"@tailwindcss/typography": "^0.5.19",
		"axe-core": "^4.11.4",
		"concurrently": "^10.0.0",
		"cypress": "^15.0.0",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-cypress": "^6.2.1",
		"eslint-plugin-svelte": "^3.9.0",
		"globals": "^16.0.0",
		"husky": "^9.1.7",
		"i18next-cli": "^1.58.3",
		"jsdom": "^29.1.1",
		"lint-staged": "^17.0.6",
		"postcss": "^8.5.15",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.0.0",
		"rollup-plugin-visualizer": "^7.0.1",
		"sass-embedded": "^1.100.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte-confetti": "^2.3.2",
		"tailwindcss": "^4.3.0",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.60.0",
		"vite": "^6.4.2",
		"vitest": "^4.1.7"
	},
	"type": "module",
	"dependencies": {
		"@azure/msal-browser": "^4.30.0",
