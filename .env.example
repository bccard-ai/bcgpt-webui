# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://localhost:11434'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# CORS: in split-port dev (`npm run dev`), the frontend runs on :5173 and the
# backend on :8090, so browser API calls are cross-origin. The backend only
# emits CORS headers when origins are configured here (semicolon-separated);
# otherwise same-origin is enforced and the SPA shows "backend required".
# For production, set this to your real origin(s) instead of localhost.
CORS_ALLOW_ORIGIN=http://localhost:5173;http://localhost:8090

# SECURITY (REQUIRED in production): secret used to sign session JWTs.
# It MUST be a long, random, STABLE value — if it changes, every issued session
# cookie is invalidated and users get 401 -> redirected to the login page.
# For `npm run dev`, if this is left unset the dev launcher
# (scripts/watch-backend.js) auto-generates a key once and persists it to
# node_modules/.cache/bcgpt-secret-key so sessions survive restarts; set it
# explicitly here to pin a value. Generate e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BCGPT_SECRET_KEY=

# SECURITY: Tool/function code is executed via exec() WITHOUT sandboxing — it
# runs with the full privileges of the server process. By default only admins
# may author such code. Set this to true ONLY if you intend to let non-admin
# users with the "workspace.tools" permission author tool code (RCE-equivalent),
# and only with OS-level isolation in place.
TOOLS_ALLOW_NON_ADMIN_CODE=false

# Reverse-proxy hops to trust for X-Forwarded-For (used by the rate limiter to
# identify clients). 0 (default) = never trust XFF — clients are keyed by the
# direct socket IP, so a spoofed XFF header cannot evade rate limits. Set to the
# number of trusted proxies in front of the app (e.g. 1 behind a single nginx).
PROXY_TRUST_DEPTH=0

# SECURITY: If you use BCGPT_AUTH_TRUSTED_EMAIL_HEADER (reverse-proxy SSO), list
# the proxy source IP(s)/CIDR(s) here. The trusted email/name headers are then
# honored ONLY when the request's direct peer matches — so a spoofed header from
# a client that reaches the backend port directly cannot log in as any user.
# Empty = not enforced (relies on network isolation; a startup warning is shown).
BCGPT_AUTH_TRUSTED_PROXY_IPS=

# Max upload size in MB (applies to file + knowledge uploads). Bounds memory/disk
# use from oversized uploads. Default 100. Frontend and backend both interpret
# this as MB.
RAG_FILE_MAX_SIZE=100

# ───────────────────────────────────────────────────────────────────────────
# open-moai adoption — Phase 1 (risk-free backend algorithm / security wins)
# Algorithms re-implemented from open-moai (Apache-2.0). All opt-in (default
# OFF) except the two safety-hardening flags that default ON (entity guard,
# file magic validation). Flag OFF => behavior is byte-identical to before.
# ───────────────────────────────────────────────────────────────────────────

# 1.1 Content isolation / spotlighting: defensively wrap untrusted RAG/web/tool
# context so the model treats it as DATA only (indirect prompt-injection defense,
# MS "Spotlighting" 2024). METHOD: datamarking (default) | base64 | delimiter.
# base64 is most robust but harms citation/comprehension — use only when needed.
CONTENT_ISOLATION_ENABLED=false
CONTENT_ISOLATION_METHOD=datamarking

# 1.2 MMR diversity reranking (Carbonell & Goldstein 1998) in the advanced RAG
# pipeline: trade relevance for novelty to avoid near-duplicate top-k.
# LAMBDA in [0,1]: 1.0 = pure relevance, lower = more diversity. Default 0.7.
RAG_MMR_ENABLED=false
RAG_MMR_LAMBDA=0.7

# 1.3 Deterministic (no-LLM) citation-grounding audit in the agent quality
# pipeline: measures numeric/factual-claim citation coverage + Jaccard grounding
# (CJK-aware). Toggled with the other agent quality stages.
QUALITY_CITATION_AUDIT_ENABLED=false

# 1.4 Named-entity preservation in LLM query rewriting (default ON, safety
# hardening): if a rewrite silently drops an explicit financial entity
# (company/ticker/fund), fall back to the original query.
QUERY_REWRITE_ENTITY_GUARD_ENABLED=true

# 1.5 EU AI Act / Korean AI Basic Act structured AI-interaction audit logging: one
# audit row per response with model/provider, in/out tokens, guardrail outcome,
# tool/RAG/web usage, and latency. Stores no message content (PII-free).
AI_INTERACTION_AUDIT_ENABLED=false

# 1.6 Magic-byte file signature validation on upload (default ON, safety
# hardening): cross-check magic bytes vs extension to block MIME/extension
# spoofing (e.g. an executable renamed .png). Fail-secure on read errors.
FILE_MAGIC_VALIDATION_ENABLED=true

# ───────────────────────────────────────────────────────────────────────────
# open-moai adoption — Phase 2 (governance / FinOps / ingest-quality backbone)
# ───────────────────────────────────────────────────────────────────────────

# 2.1 Token/cost usage persistence (FinOps backbone): write one llm_token_usage
# row per response with cost computed from the model_pricing table. Powers the
# /api/v1/usage aggregation API (by user/model/agent/day). Requires the
# b1c2d3e4f5a6 migration. Default pricing is seeded at startup when enabled.
TOKEN_USAGE_PERSIST_ENABLED=false

# 2.2 Token/cost budget (OWASP LLM10 denial-of-wallet): per-user daily/per-minute
# token caps (0 = unlimited). Group-level overrides via groups.permissions
# ("token_budget": {"daily_tokens": N, "per_minute_tokens": N}). Admins exempt.
TOKEN_BUDGET_ENABLED=false
TOKEN_BUDGET_DAILY=0
TOKEN_BUDGET_PER_MIN=0

# 2.6 Ingestion-time chunk-quality scorer (GIGO mitigation): drop reject-grade
# chunks (too short / repetitive / low-information; CJK script-aware) at RAG
# ingest. Fails open if it would reject every chunk of a document.
RAG_CHUNK_QUALITY_ENABLED=false

# 2.6 CSV/TSV column-type profiler: attach a {column: type} map
# (currency/percent/date/number/...) to each ingested tabular chunk's metadata.
RAG_COLUMN_PROFILER_ENABLED=false

# 2.4 Chat data retention + anonymization (GDPR/PIPA). A daily job enforces the
# threshold: DAYS=0 disables it; with ANONYMIZE=true it PII-masks chats past the
# threshold (keeps the row), otherwise it deletes them.
CHAT_RETENTION_DAYS=0
CHAT_RETENTION_ANONYMIZE=false

# 2.5 MFA (TOTP). When enabled, sign-in requires a TOTP code for users who have
# enrolled (POST /api/v1/auths/mfa/enroll → /mfa/verify). REQUIRED_FOR_ADMIN
# flags un-enrolled admins for the UI to prompt enrollment (does not lock out).
MFA_ENABLED=false
MFA_REQUIRED_FOR_ADMIN=false

# ───────────────────────────────────────────────────────────────────────────
# open-moai adoption — Phase 3.4 (auth federation: RS256/JWKS + SCIM 2.0)
# ───────────────────────────────────────────────────────────────────────────

# JWT signing algorithm. HS256 (default; symmetric, uses BCGPT_SECRET_KEY) or
# RS256 (asymmetric; the public key is published at /api/v1/auths/jwks). For
# RS256, provide PEM keys inline ("\n"-escaped) OR via *_FILE paths.
# Misconfiguration falls back to HS256. Rotate by changing keys + JWT_KEY_ID.
JWT_ALGORITHM=HS256
JWT_KEY_ID=bcgpt-key-1
# JWT_RSA_PRIVATE_KEY_FILE=/run/secrets/jwt_private.pem
# JWT_RSA_PUBLIC_KEY_FILE=/run/secrets/jwt_public.pem
# JWT_RSA_PRIVATE_KEY=
# JWT_RSA_PUBLIC_KEY=

# SCIM 2.0 provisioning (Okta/Entra auto-provisioning). The IdP authenticates to
# /api/v1/scim/v2/* with SCIM_TOKEN as a bearer token. Generate a strong token,
# e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
SCIM_ENABLED=false
SCIM_TOKEN=

# ===========================================================================
# AI Compliance Module
# Korean AI Basic Act, FSC Financial AI Guidelines, EU AI Act, ISO/IEC 42001
# All modules are OFF by default. Enable individually as needed.
# ===========================================================================

# Master switch — when OFF, all compliance endpoints return 403
COMPLIANCE_ENABLED=false

# AI Model Inventory + risk tiering (AI Basic Act Art. 33)
COMPLIANCE_INVENTORY_ENABLED=false

# AIIA — AI Impact Assessment workflow (AI Basic Act Art. 35)
COMPLIANCE_AIIA_ENABLED=false

# HITL — Human-in-the-Loop approval gates (AI Basic Act Art. 34(1)(4))
COMPLIANCE_HITL_ENABLED=false
COMPLIANCE_HITL_SLA_SECONDS=300

# AI Incident Response + regulatory reporting (EU AI Act Art. 73)
COMPLIANCE_INCIDENT_ENABLED=false

# Fairness / Bias Testing (FSC principle "Reliability")
COMPLIANCE_FAIRNESS_ENABLED=false

# RAG Provenance — tamper-evident retrieval chain (EU AI Act Art. 12)
COMPLIANCE_PROVENANCE_ENABLED=false

# DSAR — Data Subject Access Requests (PIPA Art. 37-2)
COMPLIANCE_DSAR_ENABLED=false

# Vendor / AIBOM management (NIST GOVERN-6)
COMPLIANCE_VENDOR_ENABLED=false
